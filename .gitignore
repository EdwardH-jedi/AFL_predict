# Environment
.env
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Database
*.db
*.sqlite3

# Model artifacts and raw data (large files)
storage/raw_snapshots/**/*.json
storage/raw_snapshots/**/*.parquet
storage/model_artifacts/**/*.pkl

# IDE
.vscode/
.idea/
*.swp

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# Build
dist/
build/
*.egg-info/

# Claude Code local settings
.claude/

# Accidental root artifacts (T6 item 3): pip output files from unquoted `>=`
# specifiers in PowerShell, and a root-level local tool settings file
/=*
/settings.json

# generated artifacts
reviews/
data/
static/quant-dashboard/predictions.json

# Runtime logs (keep the directory itself: ops scripts redirect into logs\)
logs/*
!logs/.gitkeep
*.log
