# ---------------------------------------------------------------------------
# Generated runtime artifacts
# ---------------------------------------------------------------------------
# Raw API snapshots, feature parquets, backtest result JSON.
storage/raw_snapshots/**
!storage/raw_snapshots/.gitkeep
# Trained model binaries (tuned hyperparameter JSON files ARE tracked).
storage/model_artifacts/**/*.pkl
storage/model_artifacts/run_*/
# Daily pipeline / role-audit summary artifacts.
storage/daily_summaries/**
!storage/daily_summaries/.gitkeep
# Pipeline logs and local codex review transcripts.
logs/**
!logs/.gitkeep
reviews/
data/
# Standalone dashboard payload — regenerate with `make demo`.
static/quant-dashboard/predictions.json

# ---------------------------------------------------------------------------
