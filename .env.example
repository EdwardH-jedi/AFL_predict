# ---------------------------------------------------------------------------
# AFL Predict — Environment Variables Template
# Copy this file to .env and fill in your values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Application ---
APP_ENV=development          # development | staging | production
APP_DEBUG=true
LOG_LEVEL=INFO

# --- Database ---
# SQLite (local dev): sqlite:///./afl_predict.db
# PostgreSQL (production): postgresql+psycopg2://user:password@host:5432/afl_predict
DB_URL=sqlite:///./afl_predict.db

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=changeme-use-a-long-random-string

# --- AFL Data Source: Squiggle API (squiggle.com.au) ---
# Free, public, no API key required. Just set a polite User-Agent.
SQUIGGLE_BASE_URL=https://api.squiggle.com.au
SQUIGGLE_USER_AGENT=AFL-predict-research/0.1 (personal research; non-commercial)

# --- Odds Source: The Odds API (the-odds-api.com) ---
# Free tier: 500 requests/month. Get a key at https://the-odds-api.com
# Leave blank to skip odds ingestion (AFL fixtures will still work).
# TODO: Confirm TAB bookmaker key is available in your subscription tier.
ODDS_API_KEY=your_odds_api_key_here
ODDS_API_BASE_URL=https://api.the-odds-api.com
ODDS_API_REGION=au
# Comma-separated bookmaker preference (first found wins)
ODDS_BOOKMAKER_PREFERENCE=tab,unibet,sportsbet,betfair_ex_au

# --- Storage ---
RAW_SNAPSHOTS_DIR=./storage/raw_snapshots
MODEL_ARTIFACTS_DIR=./storage/model_artifacts

# --- Pipeline ---
PAPER_TRADE_ONLY=true        # Set to false only when system is fully validated
MIN_EDGE_THRESHOLD=0.03      # Minimum implied edge to generate a recommendation
MAX_KELLY_FRACTION=0.05      # Maximum Kelly fraction for any single bet (conservative)

# --- Pipeline Retry ---
PIPELINE_MAX_RETRIES=2
PIPELINE_RETRY_DELAY_SECONDS=30.0

# --- Data Freshness Thresholds ---
ODDS_FRESHNESS_HOURS=26.0
AFL_FRESHNESS_HOURS=48.0

# --- Daily Summary ---
DAILY_SUMMARY_DIR=./storage/daily_summaries

# --- Live-Readiness Thresholds ---
READINESS_MIN_SETTLED_BETS=100
READINESS_MAX_DRAWDOWN=0.25
READINESS_MAX_ECE=0.06
READINESS_MAX_FAILED_JOBS_7D=2

# --- Telegram Notifications ---
# 1. Create a bot via @BotFather on Telegram → get the token below
# 2. Send /start to your bot, then message @userinfobot to get your chat ID
# 3. Set TELEGRAM_ENABLED=true to activate
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false
